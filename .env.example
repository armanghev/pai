# Copy to .env (never commit .env). With deploy/install.sh: /opt/pai/.env, mode 600, owned by pai.

# From @BotFather after /newbot
TELEGRAM_TOKEN=
# Your numeric Telegram user ID (message @userinfobot to get it)
TELEGRAM_USER_ID=

# From console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# Phase 2. Canvas > Account > Settings > New access token
CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_TOKEN=

# Phase 4. github.com/settings/personal-access-tokens > Fine-grained, read-only:
# Contents, Actions, Issues, Pull requests, Metadata on the repos Pai should watch.
GITHUB_TOKEN=

# Optional: the vault git clone on Railway (deploy/railway-start.sh).
# VAULT_REPO=https://github.com/you/notes.git
# VAULT_TOKEN=
# VAULT_GIT_NAME=Pai
# VAULT_GIT_EMAIL=12345+you@users.noreply.github.com   # your GitHub noreply address

# Optional: read-only money via Plaid (docs/plaid.md).
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PAI_TOKEN_KEY=                                        # any long random string
